# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

PORT=5001
MONGODB_URI=mongodb://localhost:27017/ai-detector

# Use a long, random string — do NOT reuse this or any project's example value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Groq API key (OpenAI-compatible). Get one at https://console.groq.com
# Leave blank or set to "your_..." to force heuristic-only mode.
OPENAI_API_KEY=your_groq_api_key_here

CLIENT_ORIGIN=http://localhost:5173